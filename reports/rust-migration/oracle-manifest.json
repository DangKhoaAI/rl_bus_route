  "discrepancies": [
    {
      "area": "tick ordering",
      "description": "sim/engine.advance_interval applies the action before the first tick, so the decision precedes that tick's phase completion and arrivals. Base spec section 4.1 lists completion and arrivals before the action at the boundary.",
      "id": "D1-action-before-tick-order",
      "port_decision": "Follow the code (matches Rust spec section 3.3). Do not reorder.",
      "reproducer": "advance_interval(state, scenario, DISPATCH) then inspect the first advance_tick: the new DEADHEAD vehicle exists before arrivals are appended."
    },
    {
      "area": "boarding timing",
      "description": "The engine boards every TERMINAL_IDLE bus on every tick, not at the dispatcher departure instant. Base spec section 4.1 says terminal boarding happens at departure; Rust spec section 3.3 says 'board terminal-idle', matching the code.",
      "id": "D2-terminal-boarding-at-idle",
      "port_decision": "Follow the code.",
      "reproducer": "park an empty FULL bus at an origin terminal with waiting riders and call advance_tick once: load increases without a departure event."
    },
    {
      "area": "evaluation metrics",
      "description": "state.departures records pattern.name (str) for pending_extra departures and pattern.value (int) for scheduled full departures. evaluation/runner filters `event.get('pattern') != 'FULL'`, so only extra departures (dispatched/reassigned/short) enter the headway gap statistics; scheduled FULL departures are dropped.",
      "id": "D3-departure-pattern-type",
      "port_decision": "Reproduce the exact filter during R3 evaluator parity; raise as a metric revision separately.",
      "reproducer": "run any controller: most departures have pattern=0 and are skipped by the filter, so mean_headway_s reflects a subset."
    },
    {
      "area": "passenger timestamps",
      "description": "sim/passengers computes boarding/completion/abandonment tick indices with the literal 30 instead of config.tick_s.",
      "id": "D4-hardcoded-tick-seconds",
      "port_decision": "Only tick_s=30 is supported; replicate the literal for parity.",
      "reproducer": "construct SimConfig(tick_s=60); boarding_tick is current_time_s//30."
    },
    {
      "area": "costs and observation",
      "description": "Excessive-wait threshold 900s and comfort capacity 30 are literals in rewards/costs.integrate_tick_costs and env/observation.observe; SimConfig.comfort_capacity is unused.",
      "id": "D5-hardcoded-time-and-comfort-thresholds",
      "port_decision": "Replicate literals; keep config unused for parity.",
      "reproducer": "set comfort_capacity=0; crowding cost is unchanged."
    },
    {
      "area": "observation",
      "description": "routes[:,7] is state.depot_count/16 (all DEPOT_IDLE) while base spec section 8.1 describes a cooldown-aware reserve-compatible count.",
      "id": "D6-depot-feature-counts-all-idle",
      "port_decision": "Follow the code.",
      "reproducer": "dispatch a reserve bus: it leaves DEPOT_IDLE and the feature drops immediately even before the cooldown matters."
    },
    {
      "area": "observation",
      "description": "vehicles[:,26] equals vehicles[:,23] (both remaining_s/horizon); the documented 'nominal time-to-terminal' channel is not distinct.",
      "id": "D7-duplicate-vehicle-scalars",
      "port_decision": "Follow the code.",
      "reproducer": "compare columns 23 and 26 over any rollout."
    },
    {
      "area": "observation",
      "description": "arrival_history uses lag=(t-1-arrival_s)//control_interval, so bin 0 holds arrivals in [t-Delta, t). This is consistent with the recent-arrivals window but is an undocumented -1 offset.",
      "id": "D8-arrival-history-off-by-one",
      "port_decision": "Replicate the formula exactly.",
      "reproducer": "arrival at tick 0 appears in lag 0 at t=120 and lag 1 at t=240."
    },
    {
      "area": "observation/forecast",
      "description": "env/observation.observe accepts a forecast argument but ignores it; the env injects the forecast tensor and enables context[2] afterwards.",
      "id": "D9-observe-forecast-parameter-unused",
      "port_decision": "Port the env-level contract (reset/step), not the dead parameter.",
      "reproducer": "call observe(state, scenario, forecast=ones) and inspect the output."
    }
  ],
