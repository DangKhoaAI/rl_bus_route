{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "rm -rf public && mkdir -p public/visualize && cp -R web/intro public/intro && cp web/station/index.html public/visualize/index.html",
  "outputDirectory": "public",
  "redirects": [
    { "source": "/", "destination": "/intro/", "permanent": false },
    { "source": "/intro", "destination": "/intro/", "permanent": true },
    { "source": "/visualize", "destination": "/visualize/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/station", "destination": "https://bus-rl-station.onrender.com/station" },
    { "source": "/simulations/:path*", "destination": "https://bus-rl-station.onrender.com/simulations/:path*" },
    { "source": "/health", "destination": "https://bus-rl-station.onrender.com/health" }
  ]
}
