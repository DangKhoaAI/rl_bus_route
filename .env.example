APP_TITLE=Bus RL Station API
SERVER__HOST=127.0.0.1
SERVER__PORT=8000
SERVER__STATIC_DIR=web/station
LOG__LEVEL=INFO
SIMULATION__CONFIG_PATH=configs/eval.toml
SIMULATION__MANIFEST_PATH=data/generated/base/manifest.json
# Add test_ood_burst / test_ood_traffic once the manifest has those days (the Docker image does).
SIMULATION__SPLITS=["validation"]
# Trained policy served as the ppo controller; empty keeps the baselines only.
SIMULATION__CHECKPOINT_PATH=runs/core-11/best.zip
SIMULATION__MAX_SESSIONS=8
SIMULATION__MAX_DECISIONS_PER_CALL=120
SIMULATION__SESSION_IDLE_S=600
